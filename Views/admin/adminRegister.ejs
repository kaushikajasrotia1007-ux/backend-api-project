<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Register</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;600&display=swap" rel="stylesheet">

  <style>
    body {
      height: 100vh;
      background: linear-gradient(135deg, #667eea, #764ba2);
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Poppins', sans-serif;
    }

    .register-card {
      width: 400px;
      padding: 30px;
      border-radius: 20px;
      background: #fff;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      animation: fadeIn 0.8s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: scale(0.9);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .register-card h2 {
      text-align: center;
      margin-bottom: 20px;
      font-weight: 600;
    }

    .form-control {
      border-radius: 10px;
      padding: 10px;
    }

    .form-control:focus {
      box-shadow: none;
      border-color: #667eea;
    }

    .btn-register {
      width: 100%;
      border-radius: 10px;
      background: #667eea;
      color: #fff;
      transition: 0.3s;
    }

    .btn-register:hover {
      background: #5a67d8;
      transform: scale(1.02);
    }

    .extra-links {
      text-align: center;
      margin-top: 15px;
      font-size: 14px;
    }

    .extra-links a {
      text-decoration: none;
      color: #667eea;
    }

    .extra-links a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>

  <div class="register-card">
    <h2>Create Admin Account</h2>

    <form method="POST" action="/adminregister">

       <% if(msg=="emailalreadyexists"){%> 
            <h6 class="alert alert-warning">email already exists</h1>
            
            <%}%>

        <% if(msg=="passnotconfirm"){%> 
            <h6 class="alert alert-warning">password not confirmed</h1>
            
            <%}%>
      <div class="mb-3">
        <label>Full Name</label>
        <input type="text" class="form-control" name="name" placeholder="Enter name" required>
      </div>

      <div class="mb-3">
        <label>Email</label>
        <input type="email" class="form-control" name="email" placeholder="Enter email" required>
      </div>

      <div class="mb-3">
        <label>Password</label>
        <input type="password" class="form-control" name="password" placeholder="Create password" required>
      </div>

      <div class="mb-3">
        <label>Confirm Password</label>
        <input type="password" class="form-control" name="confirmPassword" placeholder="Confirm password" required>
      </div>

      <button type="submit" class="btn btn-register">Register</button>

    </form>

    <div class="extra-links">
      Already have an account? <a href="/adminlogin">Login</a>
    </div>
  </div>

</body>
</html>