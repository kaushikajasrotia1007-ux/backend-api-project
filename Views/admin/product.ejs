<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: #f4f6f9;
    }

    /* Sidebar */
    .sidebar {
      width: 240px;
      height: 100vh;
      position: fixed;
      background: #1e293b;
      color: #fff;
      padding-top: 20px;
    }

    .sidebar h4 {
      text-align: center;
      margin-bottom: 30px;
    }

    .sidebar a {
      display: block;
      color: #cbd5e1;
      padding: 12px 20px;
      text-decoration: none;
      transition: 0.3s;
    }

    .sidebar a:hover {
      background: #334155;
      color: #fff;
      padding-left: 25px;
    }

    /* Main Content */
    .main {
      margin-left: 240px;
      padding: 20px;
    }

    /* Navbar */
    .topbar {
      background: #fff;
      padding: 15px 20px;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      margin-bottom: 20px;
    }

    /* Cards */
    .card-box {
      border-radius: 15px;
      padding: 20px;
      color: #fff;
      transition: 0.3s;
    }

    .card-box:hover {
      transform: translateY(-5px);
    }

    .bg1 { background: #667eea; }
    .bg2 { background: #48bb78; }
    .bg3 { background: #ed8936; }
    .bg4 { background: #e53e3e; }

  </style>
</head>

<body>

  <!-- Sidebar -->
  <div class="sidebar">
    <h4>Admin Panel</h4>
    <a href="#"><i class="bi bi-speedometer2"></i> Dashboard</a>
    <a href="#"><i class="bi bi-people"></i> Users</a>
    <a href="/admin/Product"><i class="bi bi-box"></i> Products</a>
    <a href="#"><i class="bi bi-cart"></i> Orders</a>
    <a href="#"><i class="bi bi-gear"></i> Settings</a>
    <a href="#"><i class="bi bi-box-arrow-right"></i> Logout</a>
  </div>


  <!-- Main Content -->
  <div class="main">
     <main class="col-md-10 ms-sm-auto px-md-4 mt-4">


      <!-- Page Title -->
      <div class="d-flex justify-content-between flex-wrap mb-3">
        <h2>Product Dashboard</h2>
        <button class="btn btn-primary">Add Product</button>
      </div>



<div class="container mt-5">

  <div class="row">

    <!-- ADD -->
    <div class="col-md-4">
      <div class="bg-success text-white p-4 rounded">
        <h5>Add Product</h5>
      <form action="/admin/addcategory" method="post"> 
         <input type="text" name="name" class="form-control mb-3" placeholder="Enter product name">
        <button class="btn btn-light w-100">Add</button>
      </form>
      </div>
    </div>

    <!-- UPDATE -->
    <div class="col-md-4">
      <div class="bg-warning text-dark p-4 mb-4 rounded">
        <h5>Update Product</h5>
        <form action="/admin/updatecategory" method="post">
        <select name="oldcategoryId" class="form-select mb-3">
          <option selected>Select product</option>

          <% category.forEach(function(k){%>
            <option value="<%=k._id %>">
              <%= k.name %>
            </option>
        <%  }) %>
         
        </select>
         <input type="text" name="name" class="form-control mb-3" placeholder="Enter new name">
        <button class="btn btn-dark w-100">Update</button>

       </form>

      </div>
    </div>

    <!-- DELETE -->
    <div class="col-md-4">
      <div class="bg-danger text-white p-4 rounded">
        <h5>Delete Product</h5>

        <form action="/admin/deletecategory" method="post">

        <select name="_id" class="form-select mb-3">
          <option selected>Select product</option>

           <% category.forEach(function(k){%>
            <option value="<%=k._id %>">
              <%= k.name %>
            </option>
        <%  }) %>
        
        </select>

        <button class="btn btn-light w-100">Delete</button>
        </form>
      </div>
    </div>

  </div>

</div>




<form action="/admin/addproduct" method="get" class="mb-3">
  <!-- <input type="text" name="name" placeholder="enter product name"> -->
    <button  class="btn btn-primary " type="submit">add</button>
</form>
  
      <!-- Product Table -->
       <div class="row g-3">

    <!-- Item 1 -->
    <% product.forEach(p =>{%>
      <div  class="col-12">
      <div class="card shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">

          <div class="d-flex align-items-center gap-3">
            <img src="/uploads/<%=p.image%>" alt="" class="rounded-circle" style="width: 60px; height: 60px 
            ; object-fit: cover;">
            <h6  class="mb-0"><%= p.name %></h6>
          </div>

          <div class="col-3 text-center">
            <h6 class="mb-0">
              <%= p.price %>
            </h6>
          </div>

          <div class="d-flex gap-2">
             <a href="/admin/updateproduct/<%= p._id %>"  class="btn btn-success btn-sm">update</a>
              
           <form action="/admin/deleteproduct" method="post">
             <button name="_id" value="<%= p._id %>" class="btn btn-danger btn-sm">Delete</button>
           </form>
          </div>

        </div>
      </div>
    </div>
      
      <%})
    %>

    


  </div>
      
     

    </main>
  </div>
</div>

  </div>

</body>
</html>